---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<a
  class:list={["work-card", project.data.featured && 'featured', project.data.accent === 'blue' && 'blue', 'reveal', 'block']}
  data-work-card
  data-work-type={project.data.type.toLowerCase()}
  href={`/projects/${project.id}`}
>
  <div class="work-card-content">
    <div class="flex items-start justify-between gap-4">
      <span class="eyebrow">{project.data.eyebrow}</span>
      <span class="work-card-status">{project.data.status}</span>
    </div>
    <div>
      <p class="work-card-type">{project.data.type} / {project.data.role}</p>
      <h3 class="max-w-[380px] text-2xl font-bold tracking-[-0.055em] text-white sm:text-3xl">{project.data.title}</h3>
      <p class="mt-3 max-w-[430px] text-sm leading-6 text-zinc-400">{project.data.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">{project.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      <span class="link-arrow mt-7">Read case study <span aria-hidden="true">↗</span></span>
    </div>
  </div>
</a>
